#include <winver.h>

#include "verso_version.h"

1 ICON "Verso.ico"

// JetBrains Mono (SIL Open Font License 1.1) with the slashed zero as the default
// glyph; built by tools/make_font.py. Loaded from memory at startup.
201 RCDATA "fonts\\JetBrainsMonoSlashed-Regular.ttf"
202 RCDATA "fonts\\JetBrainsMonoSlashed-Bold.ttf"
203 RCDATA "fonts\\JetBrainsMonoSlashed-Italic.ttf"
204 RCDATA "fonts\\JetBrainsMonoSlashed-BoldItalic.ttf"
// The font's license travels with the executable (Help > Third-Party Licenses).
205 RCDATA "fonts\\OFL.txt"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSO_VERSION_MAJOR,VERSO_VERSION_MINOR,VERSO_VERSION_PATCH,0
 PRODUCTVERSION VERSO_VERSION_MAJOR,VERSO_VERSION_MINOR,VERSO_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Verso"
      VALUE "FileVersion", VERSO_VERSION_STRING
      VALUE "InternalName", "Verso"
      VALUE "LegalCopyright", "Copyright 2026 David Kendig. Licensed under the Apache License 2.0."
      VALUE "OriginalFilename", "Verso.exe"
      VALUE "ProductName", "Verso"
      VALUE "ProductVersion", VERSO_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
