#pragma once
// Generated by CMake from res/version.h.in. Change the version in CMakeLists.txt
// (VERSO_VERSION); this header, the executable's version resource and the manifest
// all follow it. Plain macros, so the resource compiler can read them too.

#define VERSO_VERSION_STRING "@VERSO_VERSION@"
#define VERSO_VERSION_WSTRING L"@VERSO_VERSION@"
#define VERSO_VERSION_MAJOR @VERSO_VERSION_MAJOR@
#define VERSO_VERSION_MINOR @VERSO_VERSION_MINOR@
#define VERSO_VERSION_PATCH @VERSO_VERSION_PATCH@
