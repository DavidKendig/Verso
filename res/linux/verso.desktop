[Desktop Entry]
Type=Application
Name=Verso
GenericName=Text Editor
Comment=Text, Markdown and git editor with multiple cursors, a terminal and AI tool access
Exec=verso %F
Icon=verso
Terminal=false
StartupWMClass=verso
Categories=Utility;TextEditor;Development;
MimeType=text/plain;text/markdown;text/x-c;text/x-c++;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-java;text/x-rust;text/x-haxe;text/x-shellscript;application/json;application/xml;text/html;text/css;application/javascript;text/x-log;application/pdf;
Keywords=notepad;text;editor;code;markdown;notes;pdf;git;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=verso --new-window
